# local is the default. Deploy with public-fixture or protected-live.
APP_PROFILE=local

# Fixture mode is the default and needs no provider credentials.
ALLOW_LIVE=false

# Set these only for a maintainer-controlled live deployment.
# ALLOW_LIVE=true without a key fails fast at startup.
FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.com

# Bounded polling overrides (defaults shown; see ADR 0003).
FORTYGUARD_POLL_INTERVAL_SECONDS=5.0
FORTYGUARD_MAX_POLLS=24
FORTYGUARD_TIMEOUT_SECONDS=30.0
FORTYGUARD_404_GRACE_CHECKS=3

# Cost ledger and budget (issue #11 / ADR 0004).
# FORTYGUARD_CALL_BUDGET unset = record-only (calls are still recorded).
# Budget is counted in provider CALLS: the provider does not price per call,
# so credits come from scripts/reconcile_ledger.py (ADR 0004 5).
# FORTYGUARD_LEDGER_PATH empty = in-memory ledger only.
FORTYGUARD_CALL_BUDGET=
FORTYGUARD_LEDGER_PATH=data/ledger.jsonl

# Required for APP_PROFILE=protected-live. All routes except /health use HTTP Basic.
LIVE_AUTH_USERNAME=
LIVE_AUTH_PASSWORD=
